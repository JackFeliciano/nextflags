[Unit]
Description=NEXTFLAGS residence and citizenship desk
After=network.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/srv/nextflags
Environment=NEXTFLAGS_BASE=/nextflags/
ExecStart=/usr/bin/php -S 127.0.0.1:8125 -t showroom showroom/index.php
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/nextflags
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
